{
  "name": "vsignal",
  "displayName": "VSignal",
  "description": "%extension.description%",
  "version": "1.8.0",
  "publisher": "flowup-local",
  "license": "MIT",
  "homepage": "https://github.com/Xen3t/VSignal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xen3t/VSignal.git"
  },
  "bugs": {
    "url": "https://github.com/Xen3t/VSignal/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "notification",
    "popup",
    "agent",
    "claude-code",
    "ai",
    "powershell",
    "windows",
    "hooks",
    "quota",
    "toast"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vsignal.setup",
    "onCommand:vsignal.testClaude",
    "onCommand:vsignal.testCodex",
    "onCommand:vsignal.toggle",
    "onCommand:vsignal.refreshQuotas",
    "onCommand:vsignal.showStatus",
    "onCommand:vsignal.removeHooks"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsignal",
          "title": "VSignal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vsignal": [
        {
          "id": "vsignal.controlPanel",
          "name": "VSignal",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vsignal.toggle",
        "title": "%command.toggle%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.refreshQuotas",
        "title": "%command.refreshQuotas%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.setup",
        "title": "%command.setup%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.testClaude",
        "title": "%command.testClaude%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.testCodex",
        "title": "%command.testCodex%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.showStatus",
        "title": "%command.showStatus%",
        "category": "VSignal"
      },
      {
        "command": "vsignal.removeHooks",
        "title": "%command.removeHooks%",
        "category": "VSignal"
      }
    ],
    "configuration": {
      "title": "VSignal",
      "properties": {
        "vsignal.autoConfigure": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoConfigure%"
        },
        "vsignal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enabled%"
        },
        "vsignal.popup.claude.fiveHours": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "%configuration.popup.claude.fiveHours%"
        },
        "vsignal.popup.claude.weekly": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "markdownDescription": "%configuration.popup.claude.weekly%"
        },
        "vsignal.popup.codex.fiveHours": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "markdownDescription": "%configuration.popup.codex.fiveHours%"
        },
        "vsignal.popup.codex.weekly": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "markdownDescription": "%configuration.popup.codex.weekly%"
        },
        "vsignal.popup.claude.taskPercentage": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "markdownDescription": "%configuration.popup.claude.taskPercentage%"
        },
        "vsignal.popup.codex.taskPercentage": {
          "type": "boolean",
          "default": true,
          "order": 6,
          "markdownDescription": "%configuration.popup.codex.taskPercentage%"
        },
        "vsignal.alert.lowQuota.claude": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "markdownDescription": "%configuration.alert.lowQuota.claude%"
        },
        "vsignal.alert.lowQuota.codex": {
          "type": "boolean",
          "default": true,
          "order": 8,
          "markdownDescription": "%configuration.alert.lowQuota.codex%"
        },
        "vsignal.alert.reset.claude": {
          "type": "boolean",
          "default": true,
          "order": 9,
          "markdownDescription": "%configuration.alert.reset.claude%"
        },
        "vsignal.alert.reset.codex": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "markdownDescription": "%configuration.alert.reset.codex%"
        },
        "vsignal.alert.threshold": {
          "type": "number",
          "default": 90,
          "minimum": 50,
          "maximum": 100,
          "order": 11,
          "markdownDescription": "%configuration.alert.threshold%"
        },
        "vsignal.language": {
          "type": "string",
          "enum": [
            "auto",
            "fr",
            "en"
          ],
          "enumDescriptions": [
            "%configuration.language.auto%",
            "%configuration.language.fr%",
            "%configuration.language.en%"
          ],
          "default": "auto",
          "order": 0,
          "markdownDescription": "%configuration.language%"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "qna": false
}
