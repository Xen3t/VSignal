{
  "name": "vsignal",
  "displayName": "VSignal",
  "description": "Popups Windows discrètes qui préviennent quand une tâche Claude Code ou Codex se termine dans VS Code, avec les quotas restants.",
  "version": "1.1.2",
  "publisher": "flowup-local",
  "license": "MIT",
  "homepage": "https://github.com/Xen3t/VSignal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xen3t/VSignal.git"
  },
  "bugs": {
    "url": "https://github.com/Xen3t/VSignal/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "notification",
    "popup",
    "agent",
    "claude-code",
    "ai",
    "powershell",
    "windows",
    "hooks",
    "quota",
    "toast"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vsignal.setup",
    "onCommand:vsignal.testClaude",
    "onCommand:vsignal.testCodex",
    "onCommand:vsignal.toggle",
    "onCommand:vsignal.refreshQuotas",
    "onCommand:vsignal.showStatus",
    "onCommand:vsignal.removeHooks"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsignal",
          "title": "VSignal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vsignal": [
        {
          "id": "vsignal.controlPanel",
          "name": "VSignal",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vsignal.toggle",
        "title": "Activer / désactiver",
        "icon": "$(bell)",
        "category": "VSignal"
      },
      {
        "command": "vsignal.refreshQuotas",
        "title": "Actualiser les quotas",
        "icon": "$(refresh)",
        "category": "VSignal"
      },
      {
        "command": "vsignal.setup",
        "title": "Configurer Claude et Codex",
        "icon": "$(tools)",
        "category": "VSignal"
      },
      {
        "command": "vsignal.testClaude",
        "title": "Tester Claude",
        "category": "VSignal"
      },
      {
        "command": "vsignal.testCodex",
        "title": "Tester Codex",
        "category": "VSignal"
      },
      {
        "command": "vsignal.showStatus",
        "title": "Afficher l’état",
        "category": "VSignal"
      },
      {
        "command": "vsignal.removeHooks",
        "title": "Retirer les hooks",
        "category": "VSignal"
      }
    ],
    "configuration": {
      "title": "VSignal",
      "properties": {
        "vsignal.autoConfigure": {
          "type": "boolean",
          "default": true,
          "description": "Installe et répare automatiquement les hooks Claude/Codex au démarrage de VS Code."
        },
        "vsignal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active ou désactive toutes les popups Claude et Codex."
        },
        "vsignal.popup.claude.fiveHours": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "Affiche la barre de quota **5 h** de Claude dans les popups. Le panneau VSignal continue de l'afficher dans tous les cas."
        },
        "vsignal.popup.claude.weekly": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "markdownDescription": "Affiche la barre de quota **7 j (hebdomadaire)** de Claude dans les popups. Le panneau VSignal continue de l'afficher dans tous les cas."
        },
        "vsignal.popup.codex.fiveHours": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "markdownDescription": "Affiche la barre de quota **5 h** de Codex dans les popups. Le panneau VSignal continue de l'afficher dans tous les cas."
        },
        "vsignal.popup.codex.weekly": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "markdownDescription": "Affiche la barre de quota **7 j (hebdomadaire)** de Codex dans les popups. Le panneau VSignal continue de l'afficher dans tous les cas."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "vsignal.refreshQuotas",
          "when": "view == vsignal.controlPanel",
          "group": "navigation@1"
        },
        {
          "command": "vsignal.setup",
          "when": "view == vsignal.controlPanel",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "qna": false
}
